RUNTIME_ENV="dev"

LAUNCH_EDITOR=cursor
# API client session cookie (after sign-in).
# Intentionally not vaulted (empty session state) — set it locally, or
# `arca put arca://dev/thal/apiclient-session-cookie` + declare it in arca.toml.
APICLIENT_SESSION_COOKIE=""
DELPHIS_USER="codeshare"
DELPHIS_PASSWORD="arca://dev/thal/delphis-password"
TARSI_GEMINI_API_KEY="arca://dev/thal/tarsi-gemini-api-key"

GCP_GEMINI_API_KEY="arca://thal/gcp-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash-lite"

GCP_CLOUD_TTS_API_KEY="arca://thal/gcp-cloud-tts-api-key"

GCP_GOOGLE_CLIENT_SECRET="arca://thal/gcp-google-client-secret"
GCP_GOOGLE_CLIENT_ID="917775269297-24cjc397a4l1j2vrupi6au34ds0u26iv.apps.googleusercontent.com"

STRIPE_SECRET_KEY="arca://thal/stripe-secret-key"
# Replace this endpoint secret with your unique endpoint secret key
# If you're testing with docker, run 'pnpm stripe listen'
# If you're testing with the CLI, run 'stripe listen' to find the secret key
# If you defined your endpoint using the API or the Dashboard, check your webhook settings for your endpoint secret: https://dashboard.stripe.com/webhooks
# Then vault it: printf '%s' "$whsec" | arca put arca://thal/stripe-endpoint-secret --env dev
STRIPE_ENDPOINT_SECRET="arca://thal/stripe-endpoint-secret"
